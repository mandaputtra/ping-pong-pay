# Copy to app/.env and fill in. Never commit .env.
# VITE_ prefix = exposed to the browser; those values are public by design.
# The relayer key must NEVER carry a VITE_ prefix.

# From https://dashboard.privy.io -> your project -> Settings.
# In the dashboard, enable the login methods you want to demo (email, google,
# apple, github) and add http://localhost:3101 as an allowed origin.
VITE_PRIVY_APP_ID=

# A hot wallet used only by `pnpm relayer` to fund demo top-ups. Generate a
# throwaway one; never reuse a wallet that holds real funds.
#   node --input-type=module -e "import {generatePrivateKey} from 'viem/accounts';
#     console.log(generatePrivateKey())"
# Fund it with testnet MON (gas) and testnet USDC (inventory) before demoing.
RELAYER_PRIVATE_KEY=

# Leave empty for local development: the app falls back to
# http://localhost:8791, which is where `pnpm relayer` listens.
# Set it only when the relayer runs on another host (e.g. a deployed demo).
VITE_RELAYER_URL=